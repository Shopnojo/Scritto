# Local development settings. Never put real credentials in this file.
NODE_ENV=development
PORT=3000

# Supabase project configuration (use the publishable/anon key, never a secret key).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend-only database access for protected server operations. Never expose in the Android app.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
