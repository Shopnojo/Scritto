# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.
# Environment variables with the same names (e.g. in CI) take priority over this file.

# Gemini API keys, comma separated. Scritto AI rotates through them.
# Get keys at https://aistudio.google.com/apikey - keys from different Google Cloud
# projects give you separate quotas.
GEMINI_API_KEYS=your-first-key,your-second-key

# Supabase Auth (safe for the Android client: use the project URL and publishable key only).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Google Sign-In uses the Web OAuth client ID (not the Android OAuth client ID).
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Release signing (only needed for ./gradlew assembleRelease).
# Create a keystore once with:
#   keytool -genkeypair -keystore scritto-release.jks -alias scritto -keyalg RSA -keysize 2048 -validity 10000
RELEASE_STORE_FILE=C:/path/to/scritto-release.jks
RELEASE_STORE_PASSWORD=change-me
RELEASE_KEY_ALIAS=scritto
RELEASE_KEY_PASSWORD=change-me
