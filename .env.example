# Copy to ".env" for local work. On Vercel set the SAME names under Project -> Settings -> Environment Variables
# (tick Production, and Preview / Development if you use them). ".env" is git-ignored: never commit real values.

# --- Database (required) -----------------------------------------------------------------------------
# A Postgres connection string. Easiest: Vercel dashboard -> Storage -> Create -> Neon (Postgres). That adds
# DATABASE_URL (and POSTGRES_URL) to your project for you. Either name works. The tables are created automatically.
DATABASE_URL=

# --- Admin sign-in for the website (required) ---------------------------------------------------------
# The admin website signs in with this email + password (POST /auth/login) and gets a token.
ADMIN_EMAIL=

# Hash of the admin password. Create it with:   npm run hash-password -- "your long password"
# Put the whole printed value here, e.g.  scrypt:3f2a...:9c1d...
ADMIN_PASSWORD_HASH=

# Secret used to sign login tokens: at least 32 random characters. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts, in hours (default 12).
JWT_TTL_HOURS=12

# --- Website access (required for the browser to call the API) ----------------------------------------
# Origins of the admin website, comma separated, exactly as in the address bar (no trailing slash, no *).
# Example: https://admin.scritto.app,http://localhost:3000
ADMIN_ORIGIN=

# --- Android app (optional) -----------------------------------------------------------------------------------
# If set, the app must send the same value in the X-Scritto-App-Key header (put it in the app's .env as
# SCRITTO_APP_KEY). It only keeps casual noise out: an APK can't truly hide a key.
SCRITTO_APP_KEY=

# --- Push notifications (optional) ---------------------------------------------------------------------
# Firebase service-account JSON key (raw JSON or base64 of it) so the admin "Notifications" page can send via FCM.
# Without it, notifications are recorded as "failed". The Android app needs Firebase set up to receive them.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Housekeeping (optional) ------------------------------------------------------------------------------------
# Secret Vercel Cron sends to /api/cron/prune (it adds "Authorization: Bearer <value>" automatically).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Events older than this many days are deleted each night (default 365, minimum 7).
RETENTION_DAYS=365
